{
  "name": "vscode-pr-azdo",
  "publisher": "vinaydommeti",
  "displayName": "Azure DevOps - Code Reviews",
  "description": "Azure DevOps - Code Review Experience",
  "version": "0.0.17",
  "author": {
    "name": "Vinay Dommeti"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinaychandra/vscode-pr-azdo.git"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git",
    "vscode.microsoft-authentication"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/icons/extension-icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azdo-pr",
          "title": "Azure DevOps PR",
          "icon": "resources/icons/sidebar-icon.png"
        }
      ]
    },
    "views": {
      "azdo-pr": [
        {
          "id": "azdo-pr.activePr",
          "name": "Active Pull Request",
          "visibility": "collapsed"
        },
        {
          "id": "azdo-pr.pullRequests",
          "name": "Pull Requests",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "azdo-pr.activePr",
        "contents": "No pull request found for the current branch.\n\n[$(sparkle) Perform AI Review](command:vscode-pr-azdo.standaloneReview)\n\n[$(git-pull-request-create) Create Pull Request](command:vscode-pr-azdo.createPullRequest)",
        "when": "vscode-pr-azdo:hasAzDoRepo && vscode-pr-azdo:isAuthenticated && !vscode-pr-azdo:hasActivePr"
      },
      {
        "view": "azdo-pr.activePr",
        "contents": "Sign in to Azure DevOps to see the active pull request.\n[Sign In](command:vscode-pr-azdo.signIn)",
        "when": "vscode-pr-azdo:hasAzDoRepo && !vscode-pr-azdo:isAuthenticated"
      },
      {
        "view": "azdo-pr.activePr",
        "contents": "Open a folder containing an Azure DevOps git remote.",
        "when": "!vscode-pr-azdo:hasAzDoRepo"
      },
      {
        "view": "azdo-pr.pullRequests",
        "contents": "Open a folder containing an Azure DevOps git remote to see pull requests.",
        "when": "!vscode-pr-azdo:hasAzDoRepo"
      },
      {
        "view": "azdo-pr.pullRequests",
        "contents": "Sign in to Azure DevOps to view pull requests.\n[Sign In](command:vscode-pr-azdo.signIn)",
        "when": "vscode-pr-azdo:hasAzDoRepo && !vscode-pr-azdo:isAuthenticated"
      }
    ],
    "commands": [
      {
        "command": "vscode-pr-azdo.showDetectionStatus",
        "title": "Azure DevOps PR: Show Detection Status"
      },
      {
        "command": "vscode-pr-azdo.signIn",
        "title": "Azure DevOps PR: Sign In"
      },
      {
        "command": "vscode-pr-azdo.switchAccount",
        "title": "Azure DevOps PR: Switch Account / Tenant"
      },
      {
        "command": "vscode-pr-azdo.clearAuthCache",
        "title": "Azure DevOps PR: Clear Auth Cache"
      },
      {
        "command": "vscode-pr-azdo.verifyApi",
        "title": "Azure DevOps PR: Verify API Connection"
      },
      {
        "command": "vscode-pr-azdo.refreshPullRequests",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-pr-azdo.refreshActivePr",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-pr-azdo.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "vscode-pr-azdo.openPullRequest",
        "title": "Open Pull Request"
      },
      {
        "command": "vscode-pr-azdo.checkoutPullRequest",
        "title": "Review Pull Request",
        "icon": "$(arrow-down)"
      },
      {
        "command": "vscode-pr-azdo.reviewPullRequestFromUrl",
        "title": "Azure DevOps PR: Review Pull Request from URL",
        "icon": "$(link-external)"
      },
      {
        "command": "vscode-pr-azdo.stopReview",
        "title": "Stop No-Checkout Review",
        "icon": "$(close)"
      },
      {
        "command": "vscode-pr-azdo.toggleReviewMode",
        "title": "Toggle Review Mode",
        "icon": "$(eye)"
      },
      {
        "command": "vscode-pr-azdo.selectIteration",
        "title": "Show Pull Request Iterations",
        "icon": "$(git-compare)"
      },
      {
        "command": "vscode-pr-azdo.filterComments",
        "title": "Filter Comments",
        "icon": "$(filter)"
      },
      {
        "command": "vscode-pr-azdo.filterCommentsByAuthor",
        "title": "Filter Comments by Author",
        "icon": "$(person)"
      },
      {
        "command": "vscode-pr-azdo.openFileDiff",
        "title": "Show Changes"
      },
      {
        "command": "vscode-pr-azdo.resolveThread",
        "title": "Resolve (Fixed)"
      },
      {
        "command": "vscode-pr-azdo.wontFixThread",
        "title": "Won't Fix"
      },
      {
        "command": "vscode-pr-azdo.closeThread",
        "title": "Close"
      },
      {
        "command": "vscode-pr-azdo.reactivateThread",
        "title": "Reactivate"
      },
      {
        "command": "vscode-pr-azdo.submitComment",
        "title": "Submit Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "vscode-pr-azdo.deleteComment",
        "title": "Delete Comment",
        "icon": "$(trash)"
      },
      {
        "command": "vscode-pr-azdo.viewOriginalContext",
        "title": "View Original Context",
        "icon": "$(git-compare)"
      },
      {
        "command": "vscode-pr-azdo.resolveWithAI",
        "title": "Resolve with Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "vscode-pr-azdo.explainWithAI",
        "title": "Explain with Copilot"
      },
      {
        "command": "vscode-pr-azdo.previewAiFix",
        "title": "Azure DevOps PR: Preview AI Fix"
      },
      {
        "command": "vscode-pr-azdo.applyAiFix",
        "title": "Azure DevOps PR: Apply AI Fix",
        "icon": "$(check)"
      },
      {
        "command": "vscode-pr-azdo.applySuggestion",
        "title": "Apply Suggestion"
      },
      {
        "command": "vscode-pr-azdo.postAiReply",
        "title": "Post Reply to Thread"
      },
      {
        "command": "vscode-pr-azdo.postDraft",
        "title": "Post Draft Comment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vscode-pr-azdo.postDraftFromEdit",
        "title": "Post Comment",
        "icon": "$(check)"
      },
      {
        "command": "vscode-pr-azdo.dismissDraft",
        "title": "Dismiss Draft",
        "icon": "$(close)"
      },
      {
        "command": "vscode-pr-azdo.clearDrafts",
        "title": "Clear All AI Drafts"
      },
      {
        "command": "vscode-pr-azdo.postUserDraft",
        "title": "Post Draft Comment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vscode-pr-azdo.postUserDraftFromEdit",
        "title": "Post Comment",
        "icon": "$(check)"
      },
      {
        "command": "vscode-pr-azdo.dismissUserDraft",
        "title": "Dismiss Draft",
        "icon": "$(close)"
      },
      {
        "command": "vscode-pr-azdo.saveAsDraft",
        "title": "Save as Draft",
        "icon": "$(bookmark)",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "vscode-pr-azdo.updateDraft",
        "title": "Update Draft",
        "icon": "$(bookmark)"
      },
      {
        "command": "vscode-pr-azdo.reviewWithAI",
        "title": "Review with Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "vscode-pr-azdo.quickReviewWithAI",
        "title": "Azure DevOps PR: Quick Review with Copilot"
      },
      {
        "command": "vscode-pr-azdo.manageReviewLenses",
        "title": "Azure DevOps PR: Manage Review Lenses"
      },
      {
        "command": "vscode-pr-azdo.resetPrompts",
        "title": "Azure DevOps PR: Reset AI Prompts to Defaults"
      },
      {
        "command": "vscode-pr-azdo.viewDefaultPrompts",
        "title": "Azure DevOps PR: View Default Prompts"
      },
      {
        "command": "vscode-pr-azdo.deleteBranch",
        "title": "Delete Local Branch",
        "icon": "$(trash)"
      },
      {
        "command": "vscode-pr-azdo.createPullRequest",
        "title": "Create Pull Request",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "vscode-pr-azdo.standaloneReview",
        "title": "Perform AI Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "vscode-pr-azdo.toggleFileDiff",
        "title": "Toggle File / Diff View",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-pr-azdo.toggleFileDiff",
          "when": "vscode-pr-azdo:hasActivePr && vscode-pr-azdo:activeEditorInPr && !isInDiffEditor && (resourceScheme == file || resourceScheme == azdo-pr-git)",
          "group": "navigation@10"
        },
        {
          "command": "vscode-pr-azdo.toggleFileDiff",
          "when": "vscode-pr-azdo:hasActivePr && vscode-pr-azdo:activeEditorInPr && isInDiffEditor",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "vscode-pr-azdo.reviewPullRequestFromUrl",
          "when": "view == azdo-pr.pullRequests",
          "group": "navigation@1"
        },
        {
          "command": "vscode-pr-azdo.refreshPullRequests",
          "when": "view == azdo-pr.pullRequests",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.refreshActivePr",
          "when": "view == azdo-pr.activePr",
          "group": "navigation@1"
        },
        {
          "command": "vscode-pr-azdo.reviewWithAI",
          "when": "view == azdo-pr.activePr && vscode-pr-azdo:hasActivePr",
          "group": "navigation@2"
        },
        {
          "command": "vscode-pr-azdo.quickReviewWithAI",
          "when": "view == azdo-pr.activePr && vscode-pr-azdo:hasActivePr",
          "group": "review@1"
        },
        {
          "command": "vscode-pr-azdo.standaloneReview",
          "when": "view == azdo-pr.activePr && !vscode-pr-azdo:hasActivePr && vscode-pr-azdo:hasAzDoRepo",
          "group": "navigation@2"
        },
        {
          "command": "vscode-pr-azdo.createPullRequest",
          "when": "view == azdo-pr.activePr && !vscode-pr-azdo:hasActivePr && vscode-pr-azdo:hasAzDoRepo",
          "group": "navigation@3"
        },
        {
          "command": "vscode-pr-azdo.toggleReviewMode",
          "when": "view == azdo-pr.activePr",
          "group": "navigation@4"
        },
        {
          "command": "vscode-pr-azdo.filterComments",
          "when": "view == azdo-pr.activePr && vscode-pr-azdo:reviewMode",
          "group": "navigation@5"
        },
        {
          "command": "vscode-pr-azdo.filterCommentsByAuthor",
          "when": "view == azdo-pr.activePr && vscode-pr-azdo:reviewMode",
          "group": "navigation@6"
        },
        {
          "command": "vscode-pr-azdo.expandAll",
          "when": "view == azdo-pr.activePr && vscode-pr-azdo:hasActivePr",
          "group": "navigation@99"
        },
        {
          "command": "vscode-pr-azdo.stopReview",
          "when": "view == azdo-pr.activePr && vscode-pr-azdo:snapshotReview",
          "group": "navigation@100"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-pr-azdo.checkoutPullRequest",
          "when": "viewItem == pullRequest",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.deleteBranch",
          "when": "viewItem == activePr && !vscode-pr-azdo:snapshotReview",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.resolveThread",
          "when": "viewItem == activePr.comment",
          "group": "status"
        },
        {
          "command": "vscode-pr-azdo.wontFixThread",
          "when": "viewItem == activePr.comment",
          "group": "status"
        },
        {
          "command": "vscode-pr-azdo.closeThread",
          "when": "viewItem == activePr.comment",
          "group": "status"
        },
        {
          "command": "vscode-pr-azdo.reactivateThread",
          "when": "viewItem == activePr.comment",
          "group": "status"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "vscode-pr-azdo.viewOriginalContext",
          "when": "commentThread =~ /azdoPrThread/",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.resolveWithAI",
          "when": "commentThread =~ /azdoPrThread/",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.explainWithAI",
          "when": "commentThread =~ /azdoPrThread/",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.dismissDraft",
          "when": "commentThread =~ /azdoPrDraft/",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.dismissDraft",
          "when": "commentThread =~ /replyDraft/",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.postUserDraft",
          "when": "commentThread =~ /azdoPrUserDraft/",
          "group": "navigation"
        },
        {
          "command": "vscode-pr-azdo.dismissUserDraft",
          "when": "commentThread =~ /azdoPrUserDraft/",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "vscode-pr-azdo.submitComment",
          "when": "commentController == azdo-pr-comments && commentThread != azdoPrDraft-localOnly",
          "group": "inline@1"
        },
        {
          "command": "vscode-pr-azdo.saveAsDraft",
          "when": "commentController == azdo-pr-comments && commentThread != azdoPrDraft && commentThread != azdoPrDraft-localOnly && commentThread != azdoPrUserDraft",
          "group": "inline@2"
        },
        {
          "command": "vscode-pr-azdo.resolveThread",
          "when": "commentThread =~ /^azdoPrThread$/",
          "group": "status"
        },
        {
          "command": "vscode-pr-azdo.wontFixThread",
          "when": "commentThread =~ /^azdoPrThread$/",
          "group": "status"
        },
        {
          "command": "vscode-pr-azdo.closeThread",
          "when": "commentThread =~ /^azdoPrThread$/",
          "group": "status"
        },
        {
          "command": "vscode-pr-azdo.reactivateThread",
          "when": "commentThread =~ /azdoPrThread-inactive/",
          "group": "status"
        }
      ],
      "comments/comment/title": [
        {
          "command": "vscode-pr-azdo.deleteComment",
          "when": "commentThread =~ /azdoPrThread/ && comment == ownComment",
          "group": "inline"
        }
      ],
      "comments/comment/context": [
        {
          "command": "vscode-pr-azdo.postDraftFromEdit",
          "when": "commentThread =~ /azdoPrDraft/ && commentThread != azdoPrDraft-localOnly",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.updateDraft",
          "when": "commentThread =~ /azdoPrDraft/",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.postDraftFromEdit",
          "when": "commentThread =~ /replyDraft/",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.postUserDraftFromEdit",
          "when": "commentThread =~ /azdoPrUserDraft/",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.updateDraft",
          "when": "commentThread =~ /azdoPrUserDraft/",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.updateDraft",
          "when": "commentThread =~ /replyDraft/",
          "group": "inline"
        },
        {
          "command": "vscode-pr-azdo.deleteComment",
          "when": "commentThread =~ /azdoPrThread/ && comment == ownComment",
          "group": "9_delete"
        }
      ]
    },
    "chatAgents": [
      {
        "path": "./resources/agents/azdo-review.agent.md",
        "sessionTypes": ["agent-host-copilotcli"]
      }
    ],
    "languageModelTools": [
      {
        "name": "vscode-pr-azdo_getReviewContext",
        "toolReferenceName": "azdoReviewContext",
        "displayName": "Get Azure DevOps Review Context",
        "modelDescription": "Start or inspect an Azure DevOps review run. Call this first with the runId supplied by the extension. Without a runId, starts a detailed review of the active PR. Returns immutable comparison identity, changed paths, lens instructions, and comment context. Keep this runId for subsequent review tools.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "kind": { "type": "string", "enum": ["review", "quick"] },
            "mode": { "type": "string", "enum": ["vs-target", "staged", "unstaged", "all-uncommitted", "unpushed-commits"] },
            "lensId": { "type": "string" }
          }
        }
      },
      {
        "name": "vscode-pr-azdo_readReviewFile",
        "toolReferenceName": "azdoReadReviewFile",
        "displayName": "Read Azure DevOps Review File",
        "modelDescription": "Read numbered lines of a review's source, base, unified diff, original comment revision, or actual checkout. Source/base are the selected comparison, not an unrelated workspace. Checkout reads are only allowed during checkout-backed comment resolution. Returns totalLines and hasMore; paginate until needed context is inspected.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "path": { "type": "string", "description": "Repository-relative path." },
            "view": { "type": "string", "enum": ["source", "base", "diff", "comment", "checkout"] },
            "startLine": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 }
          },
          "required": ["runId", "path"]
        }
      },
      {
        "name": "vscode-pr-azdo_listReviewFiles",
        "toolReferenceName": "azdoListReviewFiles",
        "displayName": "List Azure DevOps Review Directory",
        "modelDescription": "List one directory at the reviewed source revision, including surrounding files and repository instruction files. Works without a clone. Use nextOffset to paginate directory entries. Omit directory to list the repository root.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "directory": { "type": "string" },
            "offset": { "type": "integer", "minimum": 0 }
          },
          "required": ["runId"]
        }
      },
      {
        "name": "vscode-pr-azdo_searchReviewFiles",
        "toolReferenceName": "azdoSearchReviewFiles",
        "displayName": "Search Azure DevOps Review Files",
        "modelDescription": "Literal text search over specified source files at the reviewed revision, or changed source files if paths is omitted. This is not a repository-wide search. Use directory listing and file reads to discover and inspect additional paths.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "query": { "type": "string", "minLength": 1 },
            "paths": { "type": "array", "items": { "type": "string" } },
            "offset": { "type": "integer", "minimum": 0 }
          },
          "required": ["runId", "query"]
        }
      },
      {
        "name": "vscode-pr-azdo_createReviewDrafts",
        "toolReferenceName": "azdoCreateReviewDrafts",
        "displayName": "Create Local Azure DevOps Review Drafts",
        "modelDescription": "Create editable inline AI draft comments for a detailed review run. Does not publish to Azure DevOps. Only changed files in this run are accepted. Use right/new source lines, or left/base lines for deleted code. Exact retries are deduplicated. Stale PR/iteration results are rejected.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "line": { "type": "integer", "minimum": 1 },
                  "endLine": { "type": "integer", "minimum": 1 },
                  "side": { "type": "string", "enum": ["left", "right"] },
                  "type": { "type": "string", "enum": ["suggestion", "issue", "nitpick", "question"] },
                  "body": { "type": "string", "minLength": 1 }
                },
                "required": ["path", "line", "body"]
              }
            }
          },
          "required": ["runId", "findings"]
        }
      },
      {
        "name": "vscode-pr-azdo_draftReviewReply",
        "toolReferenceName": "azdoDraftReviewReply",
        "displayName": "Draft Azure DevOps Review Reply",
        "modelDescription": "Prefill an editable local reply on the exact thread captured by a comment-resolution run. Does not post, resolve, or overwrite an existing reply draft. The user reviews and publishes through the normal comment UI.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "body": { "type": "string", "minLength": 1 }
          },
          "required": ["runId", "body"]
        }
      },
      {
        "name": "vscode-pr-azdo_proposeReviewFix",
        "toolReferenceName": "azdoProposeReviewFix",
        "displayName": "Propose Azure DevOps Comment Fix",
        "modelDescription": "Propose a code replacement during checkout-backed comment resolution. Read view=checkout first, then provide original code matching exactly once and its replacement. Does not edit files. The user previews and explicitly approves the fix in VS Code. No checkout means no fixes.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "path": { "type": "string" },
            "original": { "type": "string", "minLength": 1 },
            "replacement": { "type": "string" }
          },
          "required": ["runId", "path", "original", "replacement"]
        }
      }
    ],
    "configuration": {
      "title": "Azure DevOps PR",
      "properties": {
        "vscode-pr-azdo.resetFiltersOnPrChange": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Reset comment filters to **Active Comments** and **All Authors** when switching to a different pull request."
        },
        "vscode-pr-azdo.autoDeleteBranchOnSwitch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically delete the local branch when checking out a different PR. Only applies to branches that were checked out via this extension."
        },
        "vscode-pr-azdo.skipDirtyCheckoutPrompt": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Skip the dirty working tree warning when checking out a PR branch. Behaves as if you always chose **Try Anyway**."
        },
        "vscode-pr-azdo.reviewWorktreePath": {
          "type": "string",
          "default": "../${repo}.worktrees/review",
          "markdownDescription": "Path for the reusable review worktree. Relative paths are resolved from the primary repository root. Use `${repo}` for the primary repository folder name."
